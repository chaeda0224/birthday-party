{
  "name": "birthday-party",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-source.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:integration": "node --test tests/backend-contract.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "check:public": "node scripts/check-public.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.8",
    "@supabase/supabase-js": "^2.99.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
